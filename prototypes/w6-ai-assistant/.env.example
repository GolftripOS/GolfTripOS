# Copy this file to .env and fill in your key.
# Keeping the key server-side (never sent to the browser) matches the
# Supabase Edge Function design in the W1 tech-stack doc — this Express
# server plays the same role for the prototype.
ANTHROPIC_API_KEY=sk-ant-...

